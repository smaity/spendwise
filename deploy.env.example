# Template for SpendWise local deploy settings.
# Copy this file to `deploy.env` and fill in your own values.
# `deploy.env` is git-ignored and must NOT be committed.
#
# build-release.sh sources this file automatically, so you can run it with no args.
# Command-line args still override these (see ./build-release.sh header).

# Your Apple Developer Team ID. Xcode → Settings → Accounts → your team,
# or developer.apple.com/account. Leave blank to use the project's configured team.
TEAM_ID=""

# Target device UUID. Find it with: xcrun devicectl list devices
# Leave blank to auto-detect the first connected device.
DEVICE_ID=""
